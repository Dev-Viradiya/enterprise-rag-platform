# MongoDB Connection URI (Local or MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017

# JWT Secret Key (Generate a random 32+ char string in production)
SECRET_KEY=your-super-secret-jwt-key-minimum-32-chars-long

# Pinecone Vector Database Credentials
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=enterprise-rag

# Groq LLM API Key (for fast RAG query inference)
GROQ_API_KEY=your-groq-api-key-here

# Optional: Central Super Admin Initial Credentials (Default: superadmin@ragplatform.com / CentralAdmin123!)
CENTRAL_ADMIN_EMAIL=superadmin@ragplatform.com
CENTRAL_ADMIN_PASSWORD=CentralAdmin123!

# Self-registration flag (false recommended for enterprise tenant control)
ALLOW_PUBLIC_SIGNUP=false
